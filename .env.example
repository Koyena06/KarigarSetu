# Copy this file to .env, fill in the keys, then restart with: npx expo start -c
# Every key is optional — the app runs in demo mode without them.
# NOTE: EXPO_PUBLIC_* values are bundled into the app. Fine for development;
# move AI calls behind Firebase Cloud Functions before a public release.

# ── Google Gemini (one key powers everything) ─────────────────────────────
# Get a key: https://aistudio.google.com/apikey
#  • Photo studio (background removal + studio placement) → image model, PAID tier only (gemini-2.5-flash-image ≈ $0.039 per photo)
#  • Listing writer + price suggestion                    → text model, free tier available
#  • Speech-to-text for all 8 languages                   → text model, free tier available
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
EXPO_PUBLIC_GEMINI_TEXT_MODEL=gemini-3.8-flash

# ── Optional premium providers (used instead of Gemini for that feature when set) ──
# Claude — listing writer. https://console.anthropic.com
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_BASE_URL=
# Sarvam AI — speech-to-text tuned for Indian languages. https://dashboard.sarvam.ai
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_SARVAM_STT_MODEL=saarika:v2.5
# remove.bg — white background only; used for the studio only if no Gemini key. https://www.remove.bg/api
EXPO_PUBLIC_REMOVE_BG_API_KEY=

# ── Firebase (not wired up yet — for the upcoming backend) ─────────────────
# Firebase console → Project settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
